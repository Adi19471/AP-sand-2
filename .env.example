# ---------------------------------------------------------------------------
# AP SAND MANAGEMENT SYSTEM - environment template
# Copy this file to `.env.local` and fill in the values from
# Firebase Console > Project settings > Your apps > Web app > SDK setup.
# `.env.local` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional - Google Analytics for Firebase
VITE_FIREBASE_MEASUREMENT_ID=

# Permanent administrators are listed in src/firebase/firebaseConfig.js
# (ADMIN_EMAILS) and in firestore.rules. Everyone else signs in with Google
# and is approved from the Users & Access page.

# Application defaults (optional - can also be changed at runtime in Settings)
VITE_APP_NAME=AP SAND
VITE_RECEIPT_PREFIX=APS
